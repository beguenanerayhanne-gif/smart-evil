      "page": "/admin/categories/[id]",
      "regex": "^/admin/categories/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/categories/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/admin/commandes/[id]",
      "regex": "^/admin/commandes/([^/]+?)(?:/)?$",
